# ==============================================================================
# ServiceSync Agent - Variables de Entorno (Hitos S1 y S2)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Plática API (Modelo grok-4.6 - Gateway del Reto Agente 2026)
# ------------------------------------------------------------------------------
RETO_KEY=tu_clave_de_platica_aqui
API_BASE_URL=https://api.reto.pltk.mx/v1
MODEL_NAME=grok-4.6
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# 2. Supabase (Herramienta: consultar_inventario_supabase)
# Base de datos en tiempo real para cotizaciones y tabla 'servicios'
# Campos requeridos en tabla: id, nombre, precio_base, tiempo_estimado
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_role_key

# ------------------------------------------------------------------------------
# 3. Google Calendar (Herramienta: gestionar_cita_calendar)
# Autenticación mediante Service Account para verificación de disponibilidad y eventos
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
GOOGLE_CALENDAR_ID=tu_taller_calendar_id@group.calendar.google.com

# ------------------------------------------------------------------------------
# 4. n8n Automation (Herramienta: notificar_confirmacion_n8n)
# Webhook receptor para disparar notificaciones automáticas de WhatsApp
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://tu-instancia-n8n.com/webhook/servicesync-whatsapp-confirmacion

# ------------------------------------------------------------------------------
# 5. Banderas de Simulación para Pruebas de Resiliencia / Error Handling (Opcional)
# ------------------------------------------------------------------------------
# SIMULATE_SUPABASE_ERROR=false
# SIMULATE_CALENDAR_ERROR=false
# SIMULATE_N8N_ERROR=false
